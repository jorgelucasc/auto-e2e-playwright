{
  "$schema": "https://json.schemastore.org/kiro-agent.json",
  "name": "front-webtrans",
  "description": "Agente para o projeto de automacao E2E do Webtrans (Playwright + JavaScript)",
  "tools": [
    "read",
    "write",
    "shell",
    "grep",
    "glob",
    "code"
  ],
